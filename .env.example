# ============================================================
# Meta Ads Signal Assistance — environment variables
# Copy this file to .env.local for local development.
# NEVER commit real keys. See README.md for setup steps.
# ============================================================

# --- Launch mode ------------------------------------------------
# The app launches with a FREE 30-DAY TRIAL and NO payment method required.
# Keep this false for launch: zero Stripe calls happen and no Stripe UI
# is rendered. Set it to true later when paid plans are ready (see README
# section "Billing (for later)").
BILLING_ENABLED=false

# --- Supabase (from your Supabase project dashboard: Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
# Service-role key: only needed when BILLING_ENABLED=true (Stripe webhook).
# Keep secret — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# --- Stripe (ONLY needed when BILLING_ENABLED=true — ignore for launch) ---
# TEST MODE keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Webhook signing secret from: Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Price ID of the Pro plan (TEST mode): create product + recurring price in the dashboard
STRIPE_PRO_PRICE_ID=price_your_pro_price_id

# --- Meta Marketing API (Phase 1 — read-only live data) ------------------
# Only needed to enable "Live data from Meta" (connect an ad account and
# pull real numbers into the wizard). Without these, the app works exactly
# as before with manual entry — the Meta UI shows "not set up yet".
# Create the app at https://developers.facebook.com/apps → Create App →
# use case "Authenticate and request data from users with Facebook Login",
# then add the "Marketing API" product. See README section 9 for the steps.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# 32-byte key for encrypting stored Meta tokens (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Keep secret — if it is lost or rotated, every user must reconnect Meta.
META_TOKEN_ENCRYPTION_KEY=your_64_hex_character_key_here

# --- App ---
# Base URL of the app (used for metadata + auth redirects)
# Local dev: http://localhost:3000 | Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
